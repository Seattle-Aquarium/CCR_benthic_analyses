# Credentials — NEVER commit these
scripts/.env
*.env

# Classification exports (can be large; re-downloadable from Zooniverse)
exports/*.csv
exports/*.zip

# Local image directories
images/
raw/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
import_log.txt
export_log.txt
toolbox_extract_log.txt

# Per-user GUI "remember last inputs" caches — hardcoded to whoever ran the script
.percent_cover_telemetry_config.json
.zooniverse_linker_config.json

# Generated reports and run caches (regenerable, not needed to run the workflow)
reports/*.xlsx
*_cache.csv

# Claude Code personal settings (machine-specific overrides; settings.json stays shared)
.claude/settings.local.json
